source "https://rubygems.org"

# Pinned to the gem GitHub Pages uses server-side, so what you see locally
# matches what GitHub builds. To break out of this (e.g. to use Jekyll 4 or
# arbitrary plugins), switch to a GitHub Actions deploy and use:
#   gem "jekyll", "~> 4.3"
gem "github-pages", group: :jekyll_plugins

# Windows + JRuby helpers
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
